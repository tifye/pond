//go:build ignore

//kage:unit pixels

package main

// rotate vertex positions to rotate lilypad
func Fragment(position vec4, texCoord vec2, color vec4) vec4 {
    uv := texCoord 

    d := distance(uv, vec2(0.5,0.5))

    d *= 2
    d = max(0, 1 - d)

    col := vec4(0.95, 0.8, 0.3, 1.0)

    softOuterCol := col * d * 0.25 
    harshInnerCol := col * d *d *d

    return softOuterCol + harshInnerCol
}